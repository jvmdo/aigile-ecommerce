# Copy to .env only to change something: every variable below already has this
# same default in docker-compose.yml, so no .env is required.

# PostgreSQL credentials and application database (service `db`).
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce
# Host port mapped to PostgreSQL's 5432.
POSTGRES_PORT=5432

# Host port mapped to the API's 8800.
API_PORT=8800
# API log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Read by the backend process itself. Inside compose, DATABASE_URL is built from
# the POSTGRES_* values above; set these only when running the backend on the host.
# DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
# HOST=0.0.0.0
# PORT=8800
