# The database for `npm run dev` (backend on the host, Postgres from `docker compose`), matching
# the docker-compose.yml defaults. HOST, PORT and LOG_LEVEL default in src/config.ts.
# A variable set in the shell wins over this file:
#   DATABASE_URL=postgres://user:pass@localhost:5433/ecommerce npm run dev
DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/ecommerce
